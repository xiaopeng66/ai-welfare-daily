update.log
__pycache__/

# CI-only partial-failure marker: regenerated every run, never worth a commit
data/.fetch_errors

# 逐源健康台账（每轮重写、含连续失败轮数）：本地状态，不进库
data/.source-health.json

# Local run-state marker for the freshness gate (never worth a commit)
data/.last_run

# 正文层缓存（本地）：只留派生的 offer 字段进 store，论坛正文不落公开仓库
data/cache/
